---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<section class="container-page pt-12 pb-10 sm:pt-16">
  <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">{title}</h1>
  {subtitle && <p class="mt-3 max-w-2xl text-lg text-muted">{subtitle}</p>}
</section>
