---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<section class="container-page pt-14 pb-10 sm:pt-20">
  <h1 class="text-3xl font-bold tracking-tight text-ink">{title}</h1>
  {subtitle && <p class="mt-2 max-w-2xl text-muted">{subtitle}</p>}
</section>
