---
import { Icon } from 'astro-icon/components';
import Media from './Media.astro';
import ProjectLink from './ProjectLink.astro';
import { postUrl, type Post, type Project } from '~/lib/content';

interface Props {
  project: Project;
  /** The project's posts, in reading order. */
  posts: Post[];
}
const { project, posts } = Astro.props;
const { title, summary, date, cover, featured, links } = project.data;
---

<article id={project.id} class="card flex h-full scroll-mt-24 flex-col overflow-hidden">
  {featured && cover && (
    <Media src={cover} alt={title} class="hidden aspect-[4/3] w-full border-b border-line object-cover sm:block" />
  )}

  <div class="flex flex-1 flex-col gap-4 p-5">
    <header>
      <p class="eyebrow">{date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', timeZone: 'UTC' })}</p>
      <h3 class="mt-1.5 text-lg font-semibold tracking-tight text-ink">{title}</h3>
      <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-muted">{summary}</p>
    </header>

    {posts.length > 0 && (
      <ul class="space-y-1 border-t border-line pt-4">
        {posts.map((post) => (
          <li>
            <a href={postUrl(post)} class="group flex items-start gap-2 text-[0.9375rem] font-medium text-ink">
              <Icon
                name="lucide:arrow-right"
                class="mt-[0.3rem] size-3.5 shrink-0 text-subtle transition-transform group-hover:translate-x-0.5 group-hover:text-accent"
              />
              <span class="group-hover:text-accent">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    {links.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-2 pt-1">
        {links.map((link) => (
          <ProjectLink link={link} />
        ))}
      </div>
    )}
  </div>
</article>
