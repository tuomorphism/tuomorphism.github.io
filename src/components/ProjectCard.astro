---
/** A featured project: cover on the left (from `sm` up), details on the right. */
import { Icon } from 'astro-icon/components';
import Media from './Media.astro';
import ProjectLink from './ProjectLink.astro';
import { postUrl, type Post, type Project } from '~/lib/content';

interface Props {
  project: Project;
  /** The project's posts, in reading order. */
  posts: Post[];
}
const { project, posts } = Astro.props;
const { title, summary, date, cover, links } = project.data;
---

<article
  id={project.id}
  class:list={['card grid scroll-mt-24 overflow-hidden', cover && 'sm:grid-cols-[minmax(0,15rem)_minmax(0,1fr)]']}
>
  {cover && (
    <Media src={cover} alt={title} class="hidden h-full min-h-48 w-full border-r border-line object-cover sm:block" />
  )}

  <div class="flex flex-col gap-3 p-5">
    <header>
      <h3 class="text-lg font-semibold tracking-tight text-ink">{title}</h3>
      <p class="eyebrow mt-0.5">
        {date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', timeZone: 'UTC' })}
      </p>
      <p class="mt-2 text-ui text-muted">{summary}</p>
    </header>

    {posts.length > 0 && (
      <ul class="space-y-1">
        {posts.map((post) => (
          <li>
            <a href={postUrl(post)} class="group flex items-start gap-2 text-ui font-medium text-ink">
              <Icon
                name="lucide:arrow-right"
                class="mt-[0.3rem] size-3.5 shrink-0 text-subtle transition-transform group-hover:translate-x-0.5 group-hover:text-accent"
              />
              <span class="group-hover:text-accent">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    {links.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-2 pt-1">
        {links.map((link) => (
          <ProjectLink link={link} />
        ))}
      </div>
    )}
  </div>
</article>
