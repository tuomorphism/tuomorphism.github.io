---
import { formatDate, postUrl, type Post, type Project } from '~/lib/content';

interface Props {
  post: Post;
  project?: Project;
}
const { post, project } = Astro.props;
const { title, description, publishDate, draft } = post.data;
---

<article class="card card-interactive group relative p-5 sm:p-6">
  <p class="eyebrow flex flex-wrap items-center gap-x-2">
    <time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
    {project && (
      <>
        <span aria-hidden="true">·</span>
        <span>{project.data.title}</span>
      </>
    )}
    {draft && <span class="rounded bg-amber-100 px-1.5 text-amber-800">draft</span>}
  </p>
  <h2 class="mt-2 text-xl font-semibold tracking-tight text-ink transition-colors group-hover:text-accent">
    <a href={postUrl(post)}>
      <span class="absolute inset-0" aria-hidden="true"></span>
      {title}
    </a>
  </h2>
  {description && <p class="mt-2 line-clamp-3 font-serif text-[1.0625rem] leading-relaxed text-muted">{description}</p>}
</article>
