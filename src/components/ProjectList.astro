---
/** Compact, typographic project list: date column, title, summary, links. Matches PostList. */
import ProjectLink from './ProjectLink.astro';
import { postUrl, type Post, type Project } from '~/lib/content';

interface Props {
  projects: Project[];
  /** All posts; each project lists its own. */
  posts: Post[];
}
const { projects, posts } = Astro.props;
const postsOf = (id: string) => posts.filter((p) => p.data.project?.id === id);
---

<ol class="divide-y divide-line">
  {projects.map((project) => {
    const { title, summary, date, links } = project.data;
    const related = postsOf(project.id);
    return (
      <li id={project.id} class="grid scroll-mt-24 gap-x-8 gap-y-1 py-6 first:pt-0 sm:grid-cols-[7.5rem_minmax(0,1fr)]">
        <span class="pt-1 text-sm text-subtle tabular-nums">
          {date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', timeZone: 'UTC' })}
        </span>
        <div>
          <h3 class="text-lg font-semibold tracking-tight text-ink">{title}</h3>
          <p class="mt-1 text-ui text-muted">{summary}</p>
          {related.length > 0 && (
            <p class="mt-2 text-sm text-muted">
              Writing:{' '}
              {related.map((post, i) => (
                <>
                  {i > 0 && ', '}
                  <a class="link" href={postUrl(post)}>
                    {post.data.title}
                  </a>
                </>
              ))}
            </p>
          )}
          {links.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {links.map((link) => (
                <ProjectLink link={link} />
              ))}
            </div>
          )}
        </div>
      </li>
    );
  })}
</ol>
