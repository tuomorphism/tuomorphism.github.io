---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import PostCard from '~/components/PostCard.astro';
import { getPosts, getProjects } from '~/lib/content';

const [posts, projects] = await Promise.all([getPosts(), getProjects()]);
const projectById = new Map(projects.map((p) => [p.id, p]));
---

<BaseLayout title="Blog">
  <PageHero title="Blog" subtitle="Blog posts, some related to projects, some standalone thoughts and ideas." />

  <div class="container-page pb-20">
    <ul class="max-w-3xl space-y-4">
      {posts.map((post) => (
        <li>
          <PostCard post={post} project={post.data.project && projectById.get(post.data.project.id)} />
        </li>
      ))}
      {posts.length === 0 && <li class="text-muted">No posts yet.</li>}
    </ul>
  </div>
</BaseLayout>
