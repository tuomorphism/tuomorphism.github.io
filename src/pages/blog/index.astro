---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { getPosts, getProjects } from '~/lib/content';

const [posts, projects] = await Promise.all([getPosts(), getProjects()]);
---

<BaseLayout title="Blog">
  <div class="mx-auto max-w-3xl px-5 pt-14 pb-20 sm:px-8 sm:pt-20">
    <h1 class="text-3xl font-bold tracking-tight text-ink">Blog</h1>
    <p class="mt-2 mb-12 text-muted">
      Everything I’ve written, newest first. Also available as{' '}
      <a class="link" href="/rss.xml">
        RSS
      </a>
      .
    </p>
    <PostList posts={posts} projects={projects} />
  </div>
</BaseLayout>
