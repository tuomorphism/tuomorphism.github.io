---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
---

<BaseLayout title="Page not found">
  <section class="container-page py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-ink">This page doesn't exist.</h1>
    <p class="mt-3 text-lg text-muted">It may have moved, or the link may be wrong.</p>
    <div class="mt-8 flex justify-center gap-3">
      <Button href="/" label="Home" variant="primary" />
    </div>
  </section>
</BaseLayout>
