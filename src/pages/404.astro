---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
---

<BaseLayout title="Page not found">
  <section class="page-column text-center">
    <p class="eyebrow">404</p>
    <h1 class="page-title mt-2">This page doesn't exist.</h1>
    <p class="mt-3 text-lg text-muted">It may have moved, or the link may be wrong.</p>
    <div class="mt-8 flex justify-center gap-3">
      <Button href="/" label="Home" variant="primary" />
    </div>
  </section>
</BaseLayout>
