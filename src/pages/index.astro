---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { getPosts, getProjects } from '~/lib/content';
import { site } from '~/site';

const github = site.socials.find((s) => s.label === 'GitHub')!.href;
const [posts, projects] = await Promise.all([getPosts(), getProjects()]);
const selected = projects.filter((p) => p.data.featured).slice(0, 3);
---

<BaseLayout>
  <div class="page-column">
    <section class="font-serif text-xl leading-relaxed text-text">
      <p>
        I’m Tuomas. I write about mathematical modeling, spatial computing with sensor data, and machine learning:
        mostly the process of turning abstract theory into models and systems that work.
      </p>
      <p class="mt-4 font-sans text-base text-muted">
        <a class="link" href="/about">
          About me and my projects
        </a>
        <span class="mx-2 text-line" aria-hidden="true">
          /
        </span>
        <a class="link" href={github} target="_blank" rel="noreferrer">
          GitHub
        </a>
      </p>
    </section>

    {selected.length > 0 && (
      <section class="mt-16">
        <h2 class="section-title">Selected work</h2>
        <ul class="space-y-4">
          {selected.map((p) => (
            <li class="group relative grid gap-x-8 sm:grid-cols-[7.5rem_minmax(0,1fr)]">
              <span class="pt-0.5 text-sm text-subtle tabular-nums">
                {p.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', timeZone: 'UTC' })}
              </span>
              <div>
                <a
                  href={`/about#${p.id}`}
                  class="text-lg font-semibold tracking-tight text-ink transition-colors group-hover:text-accent"
                >
                  <span class="absolute inset-0" aria-hidden="true" />
                  {p.data.title}
                </a>
                <p class="line-clamp-1 text-ui text-muted">{p.data.summary}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-ui sm:pl-[calc(7.5rem+2rem)]">
          <a class="link" href="/about">
            All projects →
          </a>
        </p>
      </section>
    )}

    <section class="mt-16">
      <h2 class="section-title">Writing</h2>
      <PostList posts={posts} projects={projects} />
    </section>
  </div>
</BaseLayout>
