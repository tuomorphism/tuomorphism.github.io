---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import ProjectList from '~/components/ProjectList.astro';
import { getPosts, getProjects, seriesOf } from '~/lib/content';
import { site } from '~/site';

const [projects, posts] = await Promise.all([getProjects(), getPosts()]);
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
---

<BaseLayout
  title="About"
  description="About Tuomas: mathematical modeling, spatial computing and machine learning, and selected projects."
>
  <div class="container-page pt-14 pb-20 sm:pt-20">
    <section class="max-w-3xl">
      <h1 class="text-3xl font-bold tracking-tight text-ink">About</h1>
      <div class="mt-8 space-y-5 font-serif text-xl leading-relaxed text-text">
        <p>
          Hi! I’m Tuomas. I’m into mathematical modeling, spatial computing with sensor data, and machine learning;
          generally the process of turning abstract theory into cool models and systems.
        </p>
        <p>
          This site is a collection of projects and blog posts, ranging from complete systems to interesting deep-dives
          into current research.
        </p>
        <p>
          If you're interested in a more complete background, you can find it on my{' '}
          <a class="link" href="https://www.linkedin.com/in/tuomorphism/" target="_blank" rel="noreferrer">
            LinkedIn profile
          </a>
          .
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-2">
        {site.socials.map((s) => (
          <Button href={s.href} label={s.label} icon={s.icon} size="sm" />
        ))}
      </div>
    </section>

    {featured.length > 0 && (
      <section class="mt-20">
        <h2 class="text-xl font-semibold tracking-tight text-ink">Selected work</h2>
        <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((p) => (
            <ProjectCard project={p} posts={seriesOf(p.id, posts)} />
          ))}
        </div>
      </section>
    )}

    {others.length > 0 && (
      <section class="mt-20 max-w-3xl">
        <h2 class="mb-6 text-xl font-semibold tracking-tight text-ink">Other projects</h2>
        <ProjectList projects={others} posts={posts} />
      </section>
    )}
  </div>
</BaseLayout>
