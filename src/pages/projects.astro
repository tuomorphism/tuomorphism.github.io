---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import { getPosts, getProjects, seriesOf } from '~/lib/content';

const [projects, posts] = await Promise.all([getProjects(), getPosts()]);
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
---

<BaseLayout title="Projects">
  <PageHero
    title="Projects"
    subtitle="Gallery of projects on various topics in math, computer science and statistics."
  />

  <div class="container-page space-y-12 pb-20">
    {featured.length > 0 && (
      <section>
        <h2 class="eyebrow mb-4">Featured</h2>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((p) => (
            <ProjectCard project={p} posts={seriesOf(p.id, posts)} />
          ))}
        </div>
      </section>
    )}
    {others.length > 0 && (
      <section>
        <h2 class="eyebrow mb-4">Other projects</h2>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((p) => (
            <ProjectCard project={p} posts={seriesOf(p.id, posts)} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
